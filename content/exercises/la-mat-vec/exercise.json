{
  "title": "Matrix × vector",
  "function": "mat_vec",
  "params": [
    {
      "name": "m",
      "type": "mat"
    },
    {
      "name": "v",
      "type": "vec"
    }
  ],
  "returns": "vec",
  "library": true,
  "hints": [
    "The result has one entry per row of m.",
    "Entry i of the result is the dot product of row i with v. Your `dot` already checks lengths for you.",
    "Loop over the rows: result.append(dot(row, v))."
  ],
  "tests": [
    {
      "args": [
        [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ],
        [
          1,
          1
        ]
      ],
      "description": "each output is a row · v",
      "expected": [
        3.0,
        7.0
      ]
    },
    {
      "args": [
        [
          [
            2,
            0
          ],
          [
            0,
            3
          ]
        ],
        [
          4,
          5
        ]
      ],
      "description": "a diagonal matrix scales each axis",
      "expected": [
        8.0,
        15.0
      ]
    },
    {
      "args": [
        [
          [
            0,
            -1
          ],
          [
            1,
            0
          ]
        ],
        [
          1,
          0
        ]
      ],
      "description": "a 90° rotation",
      "hidden": true,
      "expected": [
        0.0,
        1.0
      ]
    },
    {
      "args": [
        [
          [
            1,
            2,
            3
          ]
        ],
        [
          1,
          0,
          -1
        ]
      ],
      "description": "a 1×3 matrix gives a 1-element result",
      "hidden": true,
      "expected": [
        -2.0
      ]
    },
    {
      "args": [
        [
          [
            1,
            2
          ],
          [
            3,
            4
          ],
          [
            5,
            6
          ]
        ],
        [
          2,
          -1
        ]
      ],
      "description": "a 3×2 matrix maps 2D to 3D",
      "hidden": true,
      "expected": [
        0.0,
        2.0,
        4.0
      ]
    },
    {
      "args": [
        [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ],
        [
          1,
          2,
          3
        ]
      ],
      "description": "columns must match the vector length",
      "expect_error": true,
      "hidden": true
    }
  ]
}
