{
  "title": "One momentum step",
  "function": "momentum_step",
  "params": [
    {
      "name": "w",
      "type": "vec"
    },
    {
      "name": "velocity",
      "type": "vec"
    },
    {
      "name": "grad",
      "type": "vec"
    },
    {
      "name": "lr",
      "type": "float"
    },
    {
      "name": "beta",
      "type": "float"
    }
  ],
  "returns": "mat",
  "library": true,
  "hints": [
    "The velocity is a running sum of past gradients that decays by a factor β each step.",
    "v_new = β·v + grad, then w_new = w − lr·v_new.",
    "Return a 2-row matrix: [w_new, v_new]."
  ],
  "tests": [
    {
      "args": [
        [
          1,
          2
        ],
        [
          0,
          0
        ],
        [
          0.5,
          -1
        ],
        0.1,
        0.9
      ],
      "description": "from rest, the first step is plain gradient descent",
      "expected": [
        [
          0.95,
          2.1
        ],
        [
          0.5,
          -1.0
        ]
      ]
    },
    {
      "args": [
        [
          1,
          2
        ],
        [
          1,
          1
        ],
        [
          0.5,
          -1
        ],
        0.1,
        0.9
      ],
      "description": "existing velocity keeps pushing",
      "expected": [
        [
          0.86,
          2.01
        ],
        [
          1.4,
          -0.09999999999999998
        ]
      ]
    },
    {
      "args": [
        [
          0,
          0,
          0
        ],
        [
          2,
          0,
          -2
        ],
        [
          0,
          0,
          0
        ],
        0.5,
        0.5
      ],
      "description": "no gradient: the velocity decays but still moves w",
      "hidden": true,
      "expected": [
        [
          -0.5,
          0.0,
          0.5
        ],
        [
          1.0,
          0.0,
          -1.0
        ]
      ]
    },
    {
      "args": [
        [
          1,
          2
        ],
        [
          0,
          0,
          0
        ],
        [
          1,
          1
        ],
        0.1,
        0.9
      ],
      "description": "all vectors must have the same length",
      "expect_error": true,
      "hidden": true
    }
  ]
}
