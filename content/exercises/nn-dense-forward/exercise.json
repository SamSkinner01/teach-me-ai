{
  "title": "Dense layer (forward)",
  "function": "dense_forward",
  "params": [
    {
      "name": "x",
      "type": "mat"
    },
    {
      "name": "w",
      "type": "mat"
    },
    {
      "name": "b",
      "type": "vec"
    }
  ],
  "returns": "mat",
  "library": true,
  "hints": [
    "Neuron j computes w[j] · x[i] + b[j] for example i. Stacking those gives x · wᵀ + b.",
    "x is N×in and wᵀ is in×out, so matmul(x, transpose(w)) is N×out. Then add b to every row.",
    "return add_bias(matmul(x, transpose(w)), b)"
  ],
  "tests": [
    {
      "args": [
        [
          [
            1,
            2
          ]
        ],
        [
          [
            1,
            0
          ],
          [
            0,
            1
          ],
          [
            1,
            1
          ]
        ],
        [
          0,
          0,
          0.5
        ]
      ],
      "description": "one example, 2 inputs, 3 neurons",
      "expected": [
        [
          1.0,
          2.0,
          3.5
        ]
      ]
    },
    {
      "args": [
        [
          [
            1,
            0
          ],
          [
            0,
            1
          ]
        ],
        [
          [
            2,
            3
          ]
        ],
        [
          1
        ]
      ],
      "description": "a batch of two examples into one neuron",
      "expected": [
        [
          3.0
        ],
        [
          4.0
        ]
      ]
    },
    {
      "args": [
        [
          [
            1,
            2,
            3
          ],
          [
            4,
            5,
            6
          ]
        ],
        [
          [
            1,
            -1,
            0
          ],
          [
            0.5,
            0.5,
            0.5
          ]
        ],
        [
          -1,
          1
        ]
      ],
      "description": "3 inputs, 2 neurons, batch of 2",
      "hidden": true,
      "expected": [
        [
          -2.0,
          4.0
        ],
        [
          -2.0,
          8.5
        ]
      ]
    },
    {
      "args": [
        [
          [
            1,
            2
          ]
        ],
        [
          [
            1,
            2,
            3
          ]
        ],
        [
          0
        ]
      ],
      "description": "weights must have one column per input",
      "expect_error": true,
      "hidden": true
    }
  ]
}
