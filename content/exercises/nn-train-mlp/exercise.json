{
  "title": "Train an MLP",
  "function": "train_mlp",
  "params": [
    {
      "name": "xs",
      "type": "mat"
    },
    {
      "name": "labels",
      "type": "ivec"
    },
    {
      "name": "hidden",
      "type": "int"
    },
    {
      "name": "classes",
