    },
    {
      "name": "seed",
      "type": "int"
    }
  ],
  "returns": "float",
  "library": true,
  "hints": [
    "This combines nearly everything in your library. Follow the steps in the starter comment exactly, in order.",
    "Update matrices row by row: W[i] = gd_step(W[i], dW[i], lr) (likewise b = gd_step(b, db, lr)).",
    "Compute all four gradients before updating anything: dh needs the old W2."
  ],
  "tolerance": {
    "abs": 1e-07,
    "rel": 1e-05
  },
  "time_limit": 20,
