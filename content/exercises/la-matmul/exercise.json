{
  "title": "Matrix multiplication",
  "function": "matmul",
  "params": [
    {
      "name": "a",
      "type": "mat"
    },
    {
      "name": "b",
      "type": "mat"
    }
  ],
  "returns": "mat",
  "library": true,
  "hints": [
    "If a is n×k and b is k×m, the result is n×m. The inner sizes (k) must match, so check that first.",
    "result[i][j] is the dot product of row i of a with column j of b.",
    "Either use three nested loops (i, j, then k summing a[i][k] * b[k][j]), or transpose b with your `transpose` so its columns become rows you can `dot` with."
  ],
  "tests": [
    {
      "args": [
        [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ],
        [
          [
            5,
            6
          ],
          [
            7,
            8
          ]
        ]
      ],
      "description": "2×2 times 2×2",
      "expected": [
        [
          19.0,
          22.0
        ],
        [
          43.0,
          50.0
        ]
      ]
    },
    {
      "args": [
        [
          [
            1,
            0
          ],
          [
            0,
            1
          ]
        ],
        [
          [
            9,
            8
          ],
          [
            7,
            6
          ]
        ]
      ],
      "description": "multiplying by the identity changes nothing",
      "expected": [
        [
          9.0,
          8.0
        ],
        [
          7.0,
          6.0
        ]
      ]
    },
    {
      "args": [
        [
          [
            1,
            2,
            3
          ]
        ],
        [
          [
            1
          ],
          [
            2
          ],
          [
            3
          ]
        ]
      ],
      "description": "(1×3)(3×1) is a 1×1 matrix",
      "hidden": true,
      "expected": [
        [
          14.0
        ]
      ]
    },
    {
      "args": [
        [
          [
            1
          ],
          [
            2
          ]
        ],
        [
          [
            3,
            4
          ]
        ]
      ],
      "description": "(2×1)(1×2) is a 2×2 outer product",
      "hidden": true,
      "expected": [
        [
          3.0,
          4.0
        ],
        [
          6.0,
          8.0
        ]
      ]
    },
    {
      "args": [
        [
          [
            2,
            -1,
            0
          ],
          [
            1,
            3,
            -2
          ],
          [
            0,
            1,
            4
          ]
        ],
        [
          [
            1,
            0,
            2
          ],
          [
            -1,
            2,
            0
          ],
          [
            3,
            1,
            1
          ]
        ]
      ],
      "description": "3×3 with mixed signs",
      "hidden": true,
      "expected": [
        [
          3.0,
          -2.0,
          4.0
        ],
        [
          -8.0,
          4.0,
          0.0
        ],
        [
          11.0,
          6.0,
          4.0
        ]
      ]
    },
    {
      "args": [
        [
          [
            1,
            2
          ],
          [
            3,
            4
          ],
          [
            5,
            6
          ]
        ],
        [
          [
            1,
            2,
            3,
            4
          ],
          [
            5,
            6,
            7,
            8
          ]
        ]
      ],
      "description": "(3×2)(2×4) is 3×4",
      "hidden": true,
      "expected": [
        [
          11.0,
          14.0,
          17.0,
          20.0
        ],
        [
          23.0,
          30.0,
          37.0,
          44.0
        ],
        [
          35.0,
          46.0,
          57.0,
          68.0
        ]
      ]
    },
    {
      "args": [
        [
          [
            1,
            2
          ],
          [
            3,
            4
          ]
        ],
        [
          [
            1,
            2,
            3
          ]
        ]
      ],
      "description": "inner dimensions must match",
      "expect_error": true,
      "hidden": true
    }
  ]
}
