{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "WebWorker.ImportScripts"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "mdx"
    ],
    "noEmit": true,
    "paths": {
      "monaco-esm/*": [
        "./node_modules/monaco-editor/esm/vs/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
